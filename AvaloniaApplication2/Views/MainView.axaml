<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication2.ViewModels"
        x:Class="AvaloniaApplication2.Views.MainView"
        Title="Aircraft Simulator" Width="400" Height="300">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <StackPanel Margin="20">
    <TextBlock Text="Выберите воздушное судно:" />
    <ComboBox ItemsSource="{Binding Aircrafts}"
             SelectedItem="{Binding SelectedAircraft}"
             Margin="0 10 0 0"/>

    <TextBlock Text="Статус:" Margin="0 20 0 0" />
    <TextBlock Text="{Binding StatusMessage}"
               Foreground="Green"
               FontSize="14" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
      <Button Content="Взлет"
              Command="{Binding TakeOffCommand}"
              Margin="0 0 10 0" />
      <Button Content="Посадка"
              Command="{Binding LandCommand}" />
    </StackPanel>
  </StackPanel>
</Window>